# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Without these, dev mode auto-enables mock social
# (in-memory + localStorage). Set VITE_SOCIAL_MOCK=0 to force local-only globe.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mock social backend (no Supabase, no keys). Auto-on in dev without creds above.
# VITE_SOCIAL_MOCK=1

# Sign in with Apple. On native iOS the clientId is your app's Bundle ID.
# (redirectURI is only used for the web/Android Apple flow; leave blank for iOS.)
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
